{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@howcode/common/*": ["./src/app/common/*"],
      "@howcode/app-menu": ["./src/app/app-menu/index.ts"],
      "@howcode/app-menu/*": ["./src/app/app-menu/*"],
      "@howcode/app-shell": ["./src/app/app-shell/index.ts"],
      "@howcode/app-shell/*": ["./src/app/app-shell/*"],
      "@howcode/archive": ["./src/app/archive/index.ts"],
      "@howcode/archive/*": ["./src/app/archive/*"],
      "@howcode/native-artifacts": ["./src/app/native/artifact-shell/index.ts"],
      "@howcode/native-artifacts/*": ["./src/app/native/artifact-shell/*"],
      "@howcode/chat-workspace": ["./src/app/chat-workspace/index.ts"],
      "@howcode/chat-workspace/*": ["./src/app/chat-workspace/*"],
      "@howcode/code-workspace": ["./src/app/code-workspace/index.ts"],
      "@howcode/code-workspace/*": ["./src/app/code-workspace/*"],
      "@howcode/composer": ["./src/app/composer/index.ts"],
      "@howcode/composer/*": ["./src/app/composer/*"],
      "@howcode/desktop": ["./src/app/desktop/index.ts"],
      "@howcode/desktop/*": ["./src/app/desktop/*"],
      "@howcode/native-gitops": ["./src/app/native/gitops/index.ts"],
      "@howcode/native-gitops/*": ["./src/app/native/gitops/*"],
      "@howcode/native-markdown-artifacts": ["./src/app/native/markdown-artifacts/index.ts"],
      "@howcode/native-markdown-artifacts/*": ["./src/app/native/markdown-artifacts/*"],
      "@howcode/native-interactive-artifacts": ["./src/app/native/interactive-artifacts/index.ts"],
      "@howcode/native-interactive-artifacts/*": ["./src/app/native/interactive-artifacts/*"],
      "@howcode/extensions/*": ["./src/app/extensions/*"],
      "@howcode/inbox": ["./src/app/inbox/index.ts"],
      "@howcode/inbox/*": ["./src/app/inbox/*"],
      "@howcode/query/*": ["./src/app/query/*"],
      "@howcode/roadmaps": ["./src/app/roadmaps/index.ts"],
      "@howcode/roadmaps/*": ["./src/app/roadmaps/*"],
      "@howcode/projects": ["./src/app/projects/index.ts"],
      "@howcode/projects/*": ["./src/app/projects/*"],
      "@howcode/settings/*": ["./src/app/settings/settings/*"],
      "@howcode/sessions": ["./src/app/sessions/index.ts"],
      "@howcode/sessions/*": ["./src/app/sessions/*"],
      "@howcode/shared/*": ["./shared/*"],
      "@howcode/sidebar": ["./src/app/components/sidebar/index.ts"],
      "@howcode/sidebar/*": ["./src/app/components/sidebar/*"],
      "@howcode/skills/*": ["./src/app/skills/*"],
      "@howcode/state/*": ["./src/app/state/*"],
      "@howcode/native-terminal": ["./src/app/native/terminal/index.ts"],
      "@howcode/native-terminal/*": ["./src/app/native/terminal/*"],
      "@howcode/thread": ["./src/app/thread/index.ts"],
      "@howcode/thread/*": ["./src/app/thread/*"],
      "@howcode/ui": ["./src/app/ui/index.ts"],
      "@howcode/ui/*": ["./src/app/ui/*"],
      "@howcode/workspace-shell": ["./src/app/workspace-shell/index.ts"],
      "@howcode/workspace-shell/*": ["./src/app/workspace-shell/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "stableTypeOrdering": true,
    "libReplacement": false
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/electron/**/*"]
}
