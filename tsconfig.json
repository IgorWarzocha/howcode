{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@howcode/common": ["./src/app/components/common/index.ts"],
      "@howcode/common/*": ["./src/app/components/common/*"],
      "@howcode/app-menu": ["./src/app/app-menu/index.ts"],
      "@howcode/app-menu/*": ["./src/app/app-menu/*"],
      "@howcode/composer": ["./src/app/components/workspace/composer/index.ts"],
      "@howcode/composer/*": ["./src/app/components/workspace/composer/*"],
      "@howcode/desktop": ["./src/app/desktop/index.ts"],
      "@howcode/desktop/*": ["./src/app/desktop/*"],
      "@howcode/native-gitops": ["./src/app/native/gitops/index.ts"],
      "@howcode/native-gitops/*": ["./src/app/native/gitops/*"],
      "@howcode/extensions": ["./src/app/features/extensions/index.ts"],
      "@howcode/extensions/*": ["./src/app/features/extensions/*"],
      "@howcode/query": ["./src/app/query/index.ts"],
      "@howcode/query/*": ["./src/app/query/*"],
      "@howcode/settings": ["./src/app/views/settings/index.ts"],
      "@howcode/settings/*": ["./src/app/views/settings/*"],
      "@howcode/shared/*": ["./shared/*"],
      "@howcode/sidebar": ["./src/app/components/sidebar/index.ts"],
      "@howcode/sidebar/*": ["./src/app/components/sidebar/*"],
      "@howcode/skills": ["./src/app/features/skills/index.ts"],
      "@howcode/skills/*": ["./src/app/features/skills/*"],
      "@howcode/state": ["./src/app/state/index.ts"],
      "@howcode/state/*": ["./src/app/state/*"],
      "@howcode/native-terminal": ["./src/app/native/terminal/index.ts"],
      "@howcode/native-terminal/*": ["./src/app/native/terminal/*"],
      "@howcode/thread": ["./src/app/components/workspace/thread/index.ts"],
      "@howcode/thread/*": ["./src/app/components/workspace/thread/*"],
      "@howcode/ui": ["./src/app/ui/index.ts"],
      "@howcode/ui/*": ["./src/app/ui/*"],
      "@howcode/workspace": ["./src/app/components/workspace/index.ts"],
      "@howcode/workspace/*": ["./src/app/components/workspace/*"]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "stableTypeOrdering": true,
    "libReplacement": false
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["src/electron/**/*"]
}
