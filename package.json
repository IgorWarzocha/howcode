{
  "name": "howcode",
  "productName": "howcode",
  "version": "0.1.71",
  "private": true,
  "description": "Browser coding app for Pi with projects, terminal, git, and diff workflows.",
  "license": "MIT",
  "author": "Igor Warzocha",
  "main": "build/server/index.mjs",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k \"bun run dev:web\" \"bun run dev:runtime\"",
    "dev:app-data": "HOWCODE_DEV_USER_DATA_PROFILE=app bun run dev",
    "dev:clean": "rm -rf build/server build/desktop build/resources build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map",
    "prepush:clean": "rm -rf artifacts dist build",
    "dev:web": "bun ./scripts/dev-web.ts",
    "dev:runtime": "bun ./scripts/build-runtime.ts --watch",
    "build:runtime": "bun ./scripts/build-runtime.ts",
    "build": "vite build --configLoader runner && bun run build:runtime",
    "build:release": "bun run build",
    "release:prepare": "bun run build && bun run pack:howcode",
    "pack:howcode": "bun ./scripts/pack-howcode.ts main pack",
    "publish:howcode:dry-run": "bun ./scripts/pack-howcode.ts main publish-dry-run",
    "preview": "vite preview --configLoader runner",
    "prepare": "test -d .git && husky || true",
    "test:watch": "vitest",
    "check": "bun run ai:check && bun run build",
    "ai:check": "biome check --error-on-warnings . && tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && bun run check:auxiliary && bun ./scripts/check-architecture-boundaries.ts && bun ./scripts/check-vite-import-resolution.ts && vitest run && bun run doctor",
    "check:auxiliary": "tsc -p pages/tsconfig.json --noEmit && tsc -p workers/polls/tsconfig.json --noEmit && vite build --config pages/vite.config.mts && bun build workers/polls/src/index.ts --target browser --outdir build/polls-check",
    "check:architecture": "bun ./scripts/check-architecture-boundaries.ts",
    "pages:dev": "vite --config pages/vite.config.mts",
    "pages:build": "vite build --config pages/vite.config.mts",
    "pages:preview": "vite preview --config pages/vite.config.mts",
    "doctor": "react-doctor . --project howcode --yes --verbose --blocking warning",
    "deadcode": "bun run doctor",
    "react-doctor": "bun run doctor",
    "typography:audit": "bun ./scripts/audit-typography.ts",
    "pack:howcode:dev": "bun ./scripts/pack-howcode.ts dev pack 0.1.72-dev.0",
    "publish:howcode:dev:dry-run": "bun ./scripts/pack-howcode.ts dev publish-dry-run 0.1.72-dev.0",
    "publish:howcode": "bun ./scripts/pack-howcode.ts main publish",
    "publish:howcode:dev": "bun ./scripts/pack-howcode.ts dev publish 0.1.72-dev.0",
    "typography:generate": "bun ./scripts/generate-typography-css.ts",
    "polls:deploy": "cd workers/polls && bunx wrangler deploy",
    "polls:migrate": "cd workers/polls && bunx wrangler d1 migrations apply howcode_polls --remote",
    "dev:host": "HOWCODE_DEV_SERVER_HOST=0.0.0.0 bun run dev",
    "start": "node build/server/index.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cts,mts,cjs,mjs,json,css,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@effect/sql-sqlite-node": "4.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mdxeditor/editor": "4.2.5",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "effect": "4.0.1",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "lucide-react": "1.47.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "semver": "7.8.5",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "10.0.5",
    "husky": "^9.1.7",
    "lint-staged": "17.5.1",
    "react-doctor": "0.9.14",
    "react-grab": "0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-runtime": "3.1136.0",
    "lightningcss": "1.33.0"
  }
}
