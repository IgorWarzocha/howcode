{
  "name": "howcode",
  "productName": "howcode",
  "version": "0.1.66",
  "private": true,
  "description": "Desktop coding app for Pi with projects, terminal, git, and diff workflows.",
  "license": "MIT",
  "author": "Igor Warzocha",
  "main": "build/electron/main/index.cjs",
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "dev": "bun run dev:clean && concurrently -k \"bun run dev:web\" \"bun run dev:runtime\" \"bun run dev:desktop\"",
    "dev:768p": "HOWCODE_DEV_VIEWPORT=768p bun run dev",
    "dev:app-data": "HOWCODE_DEV_USER_DATA_PROFILE=app bun run dev",
    "dev:clean": "rm -rf artifacts/electron build/electron build/desktop build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map",
    "prepush:clean": "rm -rf artifacts/electron dist build/electron build/desktop build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map",
    "dev:web": "bun ./scripts/dev-web.ts",
    "dev:runtime": "bun ./scripts/build-electron-runtime.ts --watch",
    "dev:desktop": "bun ./scripts/dev-electron.ts",
    "build:runtime": "bun ./scripts/build-electron-runtime.ts",
    "build": "vite build && bun run build:runtime && electron-builder --dir --config electron-builder.yml",
    "build:release": "vite build && bun run build:runtime && electron-builder --config electron-builder.yml --publish never",
    "build:launcher-artifacts": "bun ./scripts/package-launcher-artifacts.ts",
    "build:service-native-abi-bundles": "node ./scripts/build-release-service-native-abi-bundles.cjs",
    "release:prepare": "bun run build:release && bun run build:launcher-artifacts",
    "pack:howcode": "bun ./scripts/pack-howcode-launcher.ts main pack",
    "publish:howcode:dry-run": "bun ./scripts/pack-howcode-launcher.ts main publish-dry-run",
    "preview": "vite preview",
    "prepare": "test -d .git && husky || true",
    "postinstall": "node ./scripts/install-electron.cjs && electron-builder install-app-deps",
    "test:watch": "vitest",
    "check": "bun run ai:check && bun run build",
    "ai:check": "biome check --error-on-warnings . && tsgo --noEmit && tsgo -p tsconfig.desktop.json --noEmit && tsgo -p tsconfig.electron.json --noEmit && tsgo -p tsconfig.scripts.json --noEmit && bun ./scripts/check-vite-import-resolution.ts && vitest run",
    "pages:dev": "vite --config pages/vite.config.ts",
    "pages:build": "vite build --config pages/vite.config.ts",
    "pages:preview": "vite preview --config pages/vite.config.ts",
    "deadcode": "react-doctor . --offline --project howcode --dead-code --fail-on warning",
    "react-doctor": "react-doctor . --offline --project howcode --dead-code",
    "typography:audit": "bun ./scripts/audit-typography.ts",
    "pack:howcode:dev": "bun ./scripts/pack-howcode-launcher.ts dev pack 0.1.70-dev.1",
    "publish:howcode:dev:dry-run": "bun ./scripts/pack-howcode-launcher.ts dev publish-dry-run 0.1.70-dev.1",
    "publish:howcode": "bun ./scripts/pack-howcode-launcher.ts main publish",
    "publish:howcode:dev": "bun ./scripts/pack-howcode-launcher.ts dev publish 0.1.70-dev.1",
    "typography:generate": "bun ./scripts/generate-typography-css.ts",
    "polls:deploy": "cd workers/polls && bunx wrangler deploy",
    "polls:migrate": "cd workers/polls && bunx wrangler d1 migrations apply howcode_polls --remote"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cts,mts,cjs,mjs,json,css,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.75.3",
    "@earendil-works/pi-ai": "0.75.3",
    "@earendil-works/pi-coding-agent": "0.75.3",
    "@earendil-works/pi-tui": "0.75.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@mdxeditor/editor": "^4.0.0",
    "@pierre/diffs": "^1.2.2",
    "@pierre/trees": "1.0.0-beta.4",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.100.11",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.10.0",
    "bindings": "^1.5.0",
    "clip-filepaths": "^0.3.0",
    "esbuild": "0.28.0",
    "file-uri-to-path": "2.0.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.2",
    "tar": "^7.5.15",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@typescript/native-preview": "^7.0.0-dev.20260519.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "41.2.1",
    "electron-builder": "^26.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "react-doctor": "^0.2.1",
    "react-grab": "^0.1.37",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-runtime": "^3.1036.0",
    "@aws-sdk/core": "^3.974.5",
    "@aws-sdk/xml-builder": "^3.972.19",
    "uuid": "^14.0.0"
  }
}
