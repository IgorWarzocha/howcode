{
  "name": "howcode",
  "productName": "howcode",
  "version": "0.1.71",
  "private": true,
  "description": "Browser coding app for Pi with projects, terminal, git, and diff workflows.",
  "license": "MIT",
  "author": "Igor Warzocha",
  "main": "build/server/index.mjs",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "concurrently -k \"bun run dev:web\" \"bun run dev:runtime\"",
    "dev:app-data": "HOWCODE_DEV_USER_DATA_PROFILE=app bun run dev",
    "dev:clean": "rm -rf build/server build/desktop build/resources build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map build/dev-runtime build/dev-runtime-ready.json",
    "dev:web": "bun run generate:components && bun ./scripts/dev-web.ts",
    "dev:runtime": "bun ./scripts/build-runtime.ts --watch",
    "build:runtime": "bun run generate:components && bun ./scripts/build-runtime.ts",
    "build": "bun run generate:components && vite build --configLoader runner && bun run build:runtime",
    "build:release": "bun run build",
    "release:prepare": "bun ./scripts/prepare-howcode-release.ts",
    "pack:howcode": "bun ./scripts/pack-howcode.ts main pack",
    "publish:howcode:dry-run": "bun ./scripts/pack-howcode.ts main publish-dry-run",
    "preview": "vite preview --configLoader runner",
    "prepare": "test -d .git && husky || true",
    "check": "bun run ai:check && bun run build",
    "ai:check": "biome check --error-on-warnings . && bun run typecheck && bun run check:auxiliary && bun ./scripts/check-architecture-boundaries.ts && bun ./scripts/check-vite-import-resolution.ts && bun run doctor",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check:auxiliary": "tsc -p pages/tsconfig.json --noEmit && tsc -p workers/polls/tsconfig.json --noEmit && vite build --config pages/vite.config.mts && bun build workers/polls/src/index.ts --target browser --outdir build/polls-check",
    "check:architecture": "bun ./scripts/check-architecture-boundaries.ts",
    "pages:dev": "vite --config pages/vite.config.mts",
    "pages:build": "vite build --config pages/vite.config.mts",
    "pages:preview": "vite preview --config pages/vite.config.mts",
    "doctor": "react-doctor . --project howcode --yes --verbose --blocking warning",
    "deadcode": "bun run doctor",
    "react-doctor": "bun run doctor",
    "typography:audit": "bun ./scripts/audit-typography.ts",
    "pack:howcode:dev": "bun ./scripts/pack-howcode.ts dev pack",
    "publish:howcode:dev:dry-run": "bun ./scripts/pack-howcode.ts dev publish-dry-run",
    "publish:howcode": "bun ./scripts/pack-howcode.ts main publish",
    "publish:howcode:dev": "bun ./scripts/pack-howcode.ts dev publish",
    "typography:generate": "bun ./scripts/generate-typography-css.ts",
    "polls:deploy": "cd workers/polls && bunx wrangler deploy",
    "polls:migrate": "cd workers/polls && bunx wrangler d1 migrations apply howcode_polls --remote",
    "dev:host": "HOWCODE_DEV_SERVER_HOST=0.0.0.0 bun run dev",
    "start": "node build/server/index.mjs",
    "generate:components": "bun ./scripts/generate-component-registry.ts",
    "postinstall": "bun run generate:components",
    "pack:howcode:durable": "bun ./scripts/pack-howcode.ts durable pack",
    "publish:howcode:durable": "bun ./scripts/pack-howcode.ts durable publish",
    "publish:howcode:durable:dry-run": "bun ./scripts/pack-howcode.ts durable publish-dry-run"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cts,mts,cjs,mjs,json,css,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
