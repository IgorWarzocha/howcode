{
  "name": "howcode",
  "productName": "howcode",
  "version": "0.1.71",
  "private": true,
  "description": "Desktop coding app for Pi with projects, terminal, git, and diff workflows.",
  "license": "MIT",
  "author": "Igor Warzocha",
  "main": "build/electron/main/index.cjs",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.15.0 <27"
  },
  "scripts": {
    "dev": "bun run dev:clean && concurrently -k \"bun run dev:web\" \"bun run dev:runtime\" \"bun run dev:desktop\"",
    "dev:768p": "HOWCODE_DEV_VIEWPORT=768p bun run dev",
    "dev:app-data": "HOWCODE_DEV_USER_DATA_PROFILE=app bun run dev",
    "dev:clean": "rm -rf artifacts/electron build/electron build/desktop build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map",
    "prepush:clean": "rm -rf artifacts/electron dist build/electron build/desktop build/dev-server.json build/dev-web-bridge.mjs build/dev-web-bridge.mjs.map",
    "dev:web": "bun ./scripts/dev-web.ts",
    "dev:runtime": "bun ./scripts/build-electron-runtime.ts --watch",
    "dev:desktop": "bun ./scripts/dev-electron.ts",
    "dev:headless": "HOWCODE_HEADLESS_TOKEN=dev bun run dev:clean && HOWCODE_HEADLESS_TOKEN=dev concurrently -k \"bun run dev:web\" \"bun run dev:runtime\"",
    "dev:headless:host": "HOWCODE_DEV_SERVER_HOST=0.0.0.0 bun run dev:headless",
    "build:runtime": "bun ./scripts/build-electron-runtime.ts",
    "build": "vite build --configLoader runner && bun run build:runtime && electron-builder --dir --config electron-builder.yml",
    "build:release": "vite build --configLoader runner && bun run build:runtime && electron-builder --config electron-builder.yml --publish never",
    "build:launcher-artifacts": "bun ./scripts/package-launcher-artifacts.ts",
    "validate:release-assets": "bun ./scripts/validate-release-assets.ts",
    "build:service-native-abi-bundles": "node ./scripts/build-release-service-native-abi-bundles.cjs",
    "release:prepare": "bun run build:release && bun run build:launcher-artifacts",
    "pack:howcode": "bun ./scripts/pack-howcode-launcher.ts main pack",
    "publish:howcode:dry-run": "bun ./scripts/pack-howcode-launcher.ts main publish-dry-run",
    "preview": "vite preview --configLoader runner",
    "prepare": "test -d .git && husky || true",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test:watch": "vitest",
    "check": "bun run ai:check && bun run build",
    "ai:check": "biome check --error-on-warnings . && tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.scripts.json --noEmit && bun run check:auxiliary && bun ./scripts/check-architecture-boundaries.ts && bun ./scripts/check-vite-import-resolution.ts && vitest run && bun run doctor",
    "check:auxiliary": "tsc -p pages/tsconfig.json --noEmit && tsc -p workers/polls/tsconfig.json --noEmit && vite build --config pages/vite.config.mts && bun build workers/polls/src/index.ts --target browser --outdir build/polls-check",
    "check:architecture": "bun ./scripts/check-architecture-boundaries.ts",
    "pages:dev": "vite --config pages/vite.config.mts",
    "pages:build": "vite build --config pages/vite.config.mts",
    "pages:preview": "vite preview --config pages/vite.config.mts",
    "doctor": "react-doctor . --project howcode --yes --verbose --blocking warning",
    "deadcode": "bun run doctor",
    "react-doctor": "bun run doctor",
    "typography:audit": "bun ./scripts/audit-typography.ts",
    "pack:howcode:dev": "bun ./scripts/pack-howcode-launcher.ts dev pack 0.1.72-dev.0",
    "publish:howcode:dev:dry-run": "bun ./scripts/pack-howcode-launcher.ts dev publish-dry-run 0.1.72-dev.0",
    "publish:howcode": "bun ./scripts/pack-howcode-launcher.ts main publish",
    "publish:howcode:dev": "bun ./scripts/pack-howcode-launcher.ts dev publish 0.1.72-dev.0",
    "typography:generate": "bun ./scripts/generate-typography-css.ts",
    "polls:deploy": "cd workers/polls && bunx wrangler deploy",
    "polls:migrate": "cd workers/polls && bunx wrangler d1 migrations apply howcode_polls --remote"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cts,mts,cjs,mjs,json,css,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@effect/sql-sqlite-node": "4.0.0-rc.116",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mdxeditor/editor": "4.2.5",
    "@pierre/diffs": "1.4.3",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "effect": "4.0.0-rc.116",
    "esbuild": "0.28.2",
    "lucide-react": "1.47.0",
    "node-pty": "^1.1.0",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.8",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "husky": "^9.1.7",
    "lint-staged": "17.5.1",
    "react-doctor": "0.9.14",
    "react-grab": "0.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-runtime": "3.1136.0",
    "lightningcss": "1.33.0"
  }
}
