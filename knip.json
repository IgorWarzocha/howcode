{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "desktop/pi-threads.ts",
    "desktop/pi-skills.ts",
    "desktop/terminal/runtime.ts",
    "scripts/*.ts",
    "pages/src/main.tsx",
    "workers/polls/src/index.ts",
    "packages/howcode/bin/howcode.js",
    "src/server/index.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "desktop/**/*.{ts,mjs}",
    "shared/**/*.{ts,d.ts}",
    "scripts/**/*.ts",
    "pages/**/*.{ts,tsx}",
    "workers/polls/src/**/*.ts",
    "packages/howcode/**/*.{js,cjs,mjs}"
  ],
  "ignore": ["build/**", "dist/**", "dist-pages/**", "artifacts/**", "node_modules/**"],
  "ignoreDependencies": [
    "@earendil-works/pi-ai",
    "bindings",
    "file-uri-to-path",
    "node-pty",
    "sherpa-onnx-node",
    "tailwindcss"
  ]
}
